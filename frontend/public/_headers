# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).

# Checked with the server on every use, so an installed app finds a new deploy straight away.
# Browsers already skip their HTTP cache when they look for a new service worker; this also
# covers the manifest and any browser that does not.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
